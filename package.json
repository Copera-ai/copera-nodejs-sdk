{
  "name": "@copera.ai/sdk",
  "version": "2.1.2",
  "description": "Copera.ai NodeJS SDK",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Copera-ai/copera-nodejs-sdk.git"
  },
  "keywords": [
    "sdk",
    "typescript",
    "copera",
    "nodejs",
    "api-client"
  ],
  "author": "Christian Curi <c.christiancuri@gmail.com>",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "typesVersions": {
    "*": {
      "": [
        "./dist/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "prebuild": "node -p \"'/*This file is auto generated during build, DO NOT CHANGE OR MODIFY */\\n\\nexport const COPERA_SDK_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "tsdown",
    "test": "vitest --watch false",
    "test:watch": "vitest --watch",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^13.3.0",
    "tsdown": "^0.16.7",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^v3.2.4"
  },
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.16.1"
}
